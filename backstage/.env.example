# Скопируй в .env и заполни. Файл .env в git не попадает.

# Ключ Claude API: console.anthropic.com → API Keys. Баланс пополняется там же (Billing).
ANTHROPIC_API_KEY=sk-ant-...

# Ключ входа в админку /admin — длинная случайная строка:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKSTAGE_ADMIN_KEY=

# Адрес и порт. 8765/8766 уже заняты дашбордом и голосом Фридмана.
BACKSTAGE_HOST=0.0.0.0
BACKSTAGE_PORT=8800

# Модели по умолчанию (для отдельного клиента меняются в админке)
BACKSTAGE_MODEL_CHAT=claude-opus-5-5
BACKSTAGE_MODEL_DEEP=claude-fable-5-1
# Глубина размышлений: low | medium | high | xhigh | max
BACKSTAGE_EFFORT_CHAT=high
BACKSTAGE_EFFORT_DEEP=xhigh

# HTTPS без домена: самоподписанный сертификат (см. README, раздел «HTTPS»)
# BACKSTAGE_TLS_CERT=/opt/backstage/tls/cert.pem
# BACKSTAGE_TLS_KEY=/opt/backstage/tls/key.pem
