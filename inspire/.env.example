# ── Telegram ──────────────────────────────────────────
BOT_TOKEN=123456:ABC...            # от @BotFather
BOT_USERNAME=inspire_dance_bot     # имя бота без @
ADMIN_IDS=111111111                # ваш Telegram ID (узнать: @userinfobot); несколько — через запятую
LEADER_NAME=Чувак                  # как обращаться в утренней сводке

# ── Пульт ─────────────────────────────────────────────
DASH_PORT=8080
DASH_KEY=придумайте-длинный-ключ   # ссылка вида http://IP:8080/?key=...
DASH_ALLOWED_IPS=                  # необязательно: 85.12.34.56,91.0.0.0/16 — пускать только эти IP
PUBLIC_URL=http://203.0.113.10:8080

# ── Прочее ────────────────────────────────────────────
TIMEZONE=Europe/Berlin
DAILY_AT=08:00
CURRENCY=€
